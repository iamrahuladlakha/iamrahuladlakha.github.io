<?xml version="1.0" encoding="utf-8"?>
<!-- Renders /feed.xml as a readable page in browsers; feed readers ignore it. -->
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:atom="http://www.w3.org/2005/Atom">
<xsl:output method="html" encoding="utf-8" indent="yes"/>
<xsl:template match="/">
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="robots" content="noindex"/>
  <title>RSS feed · <xsl:value-of select="atom:feed/atom:title"/></title>
  <style>
    :root { --bg:#fbfaf7; --surface:#f3f1ec; --text:#16171a; --muted:#5f616a; --border:#e4e1d9; --accent:#0b7268; color-scheme: light dark; }
    @media (prefers-color-scheme: dark) { :root { --bg:#0d0f12; --surface:#181b20; --text:#ecedef; --muted:#a0a3ab; --border:#262a31; --accent:#40d3c0; } }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--bg); color: var(--text); font: 16px/1.6 Inter, system-ui, -apple-system, "Segoe UI", sans-serif; }
    main { max-width: 44rem; margin: 0 auto; padding: 3rem 16px 4rem; }
    .kicker { color: var(--accent); font-size: .75rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; margin: 0; }
    h1 { font-size: 2rem; line-height: 1.2; margin: .4rem 0 .6rem; letter-spacing: -.02em; }
    p { margin: 0 0 1rem; }
    .muted { color: var(--muted); }
    .box { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 1.1rem 1.2rem; margin: 1.5rem 0 2.5rem; }
    .row { display: flex; gap: .5rem; flex-wrap: wrap; margin-top: .6rem; }
    code { flex: 1 1 16rem; min-width: 0; overflow-wrap: anywhere; background: var(--bg); border: 1px solid var(--border); border-radius: 8px; padding: .5rem .7rem; font: .9rem ui-monospace, SFMono-Regular, Menlo, monospace; }
    button, .btn { border: 0; border-radius: 999px; padding: .55rem 1.1rem; background: var(--accent); color: var(--bg); font-family: inherit; font-weight: 600; font-size: .9rem; cursor: pointer; text-decoration: none; }
    a { color: var(--accent); }
    h2 { font-size: 1.1rem; margin: 0 0 1rem; }
    ol { list-style: none; padding: 0; margin: 0; }
    li { padding: 1rem 0; border-top: 1px solid var(--border); }
    li a { font-weight: 600; font-size: 1.05rem; text-decoration: none; color: var(--text); }
    li a:hover { color: var(--accent); }
    .date { font-size: .85rem; color: var(--muted); margin: .15rem 0 .35rem; }
  </style>
</head>
<body>
<main>
  <p class="kicker">RSS feed</p>
  <h1><xsl:value-of select="atom:feed/atom:title"/></h1>
  <p class="muted"><xsl:value-of select="atom:feed/atom:subtitle"/></p>
  <div class="box">
    <p><strong>This is an RSS feed.</strong> Copy the link below into a feed reader (Feedly, Inoreader, NetNewsWire, Reeder…) to get new posts as they're published. No sign-up, no email.</p>
    <div class="row">
      <code id="feed-url"><xsl:value-of select="atom:feed/atom:link[@rel='self']/@href"/></code>
      <button type="button" onclick="navigator.clipboard.writeText(document.getElementById('feed-url').textContent).then(()=>{this.textContent='Copied ✓'})">Copy link</button>
    </div>
  </div>
  <h2>Recent posts</h2>
  <ol>
    <xsl:for-each select="atom:feed/atom:entry">
      <li>
        <a href="{atom:link/@href}"><xsl:value-of select="atom:title"/></a>
        <p class="date"><xsl:value-of select="substring(atom:published, 1, 10)"/></p>
        <p class="muted"><xsl:value-of select="atom:summary"/></p>
      </li>
    </xsl:for-each>
  </ol>
  <p style="margin-top:2rem"><a class="btn" href="{atom:feed/atom:link[@rel='alternate']/@href}">← Back to the site</a></p>
</main>
</body>
</html>
</xsl:template>
</xsl:stylesheet>
